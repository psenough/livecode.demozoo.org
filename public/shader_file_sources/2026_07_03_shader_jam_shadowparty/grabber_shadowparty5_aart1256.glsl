void main(void)
{
	vec2 uv = out_texcoord;
	uv -= 0.5;
	uv /= vec2(v2Resolution.y / v2Resolution.x, 1);

	vec2 m;
	m.x = atan(uv.x / uv.y) / 3.14;
	m.y = 1 / length(uv) * .2;
	float d = m.y;

	float f = texture( texFFT, uv.x ).x*100.;
	m.x += sin( fGlobalTime ) * 0.1;
	m.y += fGlobalTime * 0.25;

	float mx = mod(fGlobalTime,2.0);
	if (mx >= 1.0) mx = 2.0-mx;
	float my = mod(fGlobalTime+0.3,1.125);
	if (my >= 0.5625) my = 1.125-my;
	mx += uv.x;
	my += uv.y;


	vec4 t = plas( uv * 3.14, fGlobalTime );
  	float d2 = 100+uv.x*3.14*sin(fGlobalTime)*40.;
	t = clamp( t, 0.0, 13.0 );
  	float ot = ((font[(7-(int(t.y*8.)&7))|((int(t.x)%13)<<3)]>>(7-(int(t.x*8.)&7)))&1)>0?1.:0.;
	ot /= 10.0/d2;
	ot = clamp(ot,0.0,1.0);
	ot *= pow(abs(sin(fGlobalTime/1.0+(int(t.y)*int(t.y)*(int(t.y)-1)))),4.0);
	vec3 final_col = vec3(ot);
	if (mx >= 0.0 && mx < 0.25 && my >= 0.0 && my < 0.25) {
		int mcol = meatsob[(int(mx*64.)&15)|((15-(int(my*64.)&15))<<4)];
		final_col = vec3(float(mcol>>16&0xff)/255.0,float(mcol>>8&0xff)/255.0,float(mcol>>0&0xff)/255.0);
	}
	out_color = vec4(final_col,1.);
}